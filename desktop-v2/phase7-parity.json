  "isolation_policy": {
    "production_project_tabs_are_parity_surfaces": true,
    "team_web_is_top_level_workspace": true,
    "heavy_capabilities_require_isolated_module_or_worktree": true,
    "examples": [
      "heavy media processing",
      "new NLE adapters",
      "model runtime infrastructure",
      "experimental automation engines"
    ],
    "promotion_rule": "Only promote an isolated capability into the primary production workspace after its contract, ownership boundary, failure isolation and native smoke gate are explicit."
  },
  "isolated_workstreams": {
    "runtime_packaging": {
      "branch": "feat/desktop-v2-runtime-packaging",
      "status": "isolated_blocker",
      "reason": "A distributable Desktop build must carry the Python Core, a Python 3.11+ runtime with numpy/pandas/scipy, and ffmpeg/ffprobe. Development-relative source paths or system tools are not packaged-runtime guarantees.",
      "blocks": [
        "packaged_python_runtime",
        "packaged_media_toolchain",
        "macos_tauri_build",
        "macos_codesign_bundle",
        "windows_tauri_build",
        "windows_installer_smoke"
      ],
      "mainline_rule": "Do not solve interpreter/tool/resource bundling by adding production tabs, shipping model weights by default, or duplicating Python business logic."
    }
  }
