.DS_Store
.build/
.playwright-cli/
.pytest_cache/
.workspace/
__pycache__/
*.py[cod]

# Scratch state written by external CLI/agent tooling while working in this repo.
# These are per-machine run logs and staged probes, not project source.
.zwork/
.video_agent/
.v2c/
out/
.codex-logs/

# Packaging staging scratch produced by desktop/scripts/stage-runtime.mjs experiments.
.packaged-home/
.packaged-home-*/
.packaged-tmp-*/
.runtime-inputs/

# Local secret files must never enter the repository.
.env
.env.*
!.env.example

# Generated desktop applications and browser QA artifacts.
*.app/
output/
desktop/src-tauri/icons/generated/

# Live workspace/project runtime state belongs to the user's workspace, not the source repository.
# Keep only the empty directory placeholder so a fresh checkout can pass project preflight.
projects/*
!projects/.gitkeep

# Host supplies this per-machine sync configuration; it must never enter the repo or App bundle.
vendor/multicam-audio-sync/scripts/config.json
