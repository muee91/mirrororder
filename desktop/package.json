{
  "name": "mirrororder-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "check:baseline": "node scripts/check-baseline.mjs",
    "check:ui-authority": "node scripts/check-ui-authority.mjs",
    "test:runtime-tools": "node --test scripts/runtime-tools.node-test.mjs",
    "verify:rc": "node scripts/verify-local-rc.mjs",
    "prepare:icons": "tauri icon ../branding/app-icon.png --output src-tauri/icons/generated",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "verify:macos-bundle": "node scripts/verify-macos-bundle.mjs",
    "smoke:host": "node scripts/host-smoke.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
