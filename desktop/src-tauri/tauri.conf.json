{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "镜序",
  "version": "0.1.0",
  "identifier": "com.mirrororder.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run stage:runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "镜序",
        "width": 1360,
        "height": 860,
        "minWidth": 1180,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/mirrororder-core/": "mirrororder-core/",
      "resources/mirrororder-python/": "mirrororder-python/",
      "resources/mirrororder-tools/": "mirrororder-tools/",
      "resources/mirrororder-runtime/": "mirrororder-runtime/"
    }
  }
}
